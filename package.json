{
  "name": "starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 9009",
    "build-storybook": "storybook build",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "npx eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "npx eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,md,graphql,gql}'",
    "prettier:fix": "prettier --loglevel warn --write 'src/**/*.{js,jsx,ts,tsx,json,md,graphql,gql}'",
    "format": "npm run prettier:fix && npm run lint:fix",
    "prepare": "npx skills experimental_install && npm run sync:stories && husky",
    "sync:stories": "cpx \"node_modules/reablocks/dist/stories/*.story.tsx\" \"src/stories/components\" -C",
    "generate:api": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.10",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.11",
    "orval": "^8.10.0",
    "reablocks": "10.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.75.0",
    "react-router": "^7.15.0",
    "react-use": "^17.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/eslint": "^9.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "cpx2": "^8.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.14",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^11.2.1",
    "prettier": "^3.8.3",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,md,graphql,gql}": [
      "prettier --write"
    ]
  }
}
